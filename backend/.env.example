# Stringa di connessione Supabase: Project Settings > Database > Connection string
# (usa quella "Session pooler" se la diretta non si connette dalla tua rete)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Obbligatorio in produzione: stringa lunga e casuale (openssl rand -hex 48)
JWT_SECRET=
# Origini frontend ammesse da CORS, separate da virgola (su Render: l'URL di Netlify)
ALLOWED_ORIGINS=https://tuo-sito.netlify.app
PORT=3001
# In locale usa "development"
NODE_ENV=development
